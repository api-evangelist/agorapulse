{
  "opencollection": "1.0.0",
  "info": {
    "name": "Agorapulse Health API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agorapulse.com/v1.0/report/health"
          },
          "docs": "Provides information about the state of the API"
        }
      ]
    }
  ],
  "bundled": true
}