{
  "opencollection": "1.0.0",
  "info": {
    "name": "Agorapulse Workspaces API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workspaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization workspaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agorapulse.com/v1.0/core/organizations/:organizationId/workspaces",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "Organization id"
              },
              {
                "name": "v",
                "value": "",
                "type": "query",
                "description": "API version"
              }
            ]
          },
          "docs": "List all the workspaces in an organization"
        }
      ]
    }
  ],
  "bundled": true
}